# todo: 修改以下环境变量值

SERVER_NAME=api-dev
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=${CHANGE_ME_DB_PASSWORD}
DB_NAME=cizhima
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=${CHANGE_ME_REDIS_PASSWORD}
JWT_SECRET=${CHANGE_ME_JWT_SECRET_AT_LEAST_32_CHARS}

# AI 配置
# Provider 可选：deepseek / dashscope / moonshot / openai / openrouter / custom
# OpenRouter 的 :free 模型按当前方案不收 Token 费，但需要你自己的 API Key。
AI_PROVIDER=openrouter
AI_API_KEY=${CHANGE_ME_OPENROUTER_API_KEY}
# OpenRouter 默认 Gemma 4 26B 免费模型；失败后依次尝试 Xing4.0、Cohere North Mini Code 免费模型。
# 以下配置可覆盖预设值：
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=google/gemma-4-26b-a4b-it:free
# AI_FALLBACK_MODELS=xingchen-agi/xing4.0-29b-a4b:free,cohere/north-mini-code:free
