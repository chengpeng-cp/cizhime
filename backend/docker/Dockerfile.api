# todo: 修改构建路径和暴露端口

FROM golang:1.26-alpine AS builder

WORKDIR /build

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /api ./service/api/

FROM alpine:latest

RUN apk --no-cache add ca-certificates tzdata
RUN addgroup -S appgroup && adduser -S appuser -G appgroup

WORKDIR /app

COPY --from=builder /api .
COPY service/api/etc/ ./etc/

RUN chown -R appuser:appgroup /app
USER appuser

EXPOSE 8888

CMD ["./api", "-f", "etc/api.yaml"]
