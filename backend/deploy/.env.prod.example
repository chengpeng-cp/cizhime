# 生产环境变量模板
# 使用方式：
#   1. 复制本文件为 .env.prod：cp .env.prod.example .env.prod
#   2. 将 CHANGE_ME_* 替换为真实值（请使用强密码）
#   3. docker compose -f docker-compose.prod.yml --env-file .env.prod up -d

# 对外端口
WEB_PORT=80

# 数据库 / Redis
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_PASSWORD
MYSQL_DATABASE=cizhima
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# JWT 签名密钥（至少 32 位随机字符串）
JWT_SECRET=CHANGE_ME_JWT_SECRET_AT_LEAST_32_CHARS

# AI 配置
AI_PROVIDER=openrouter
AI_API_KEY=CHANGE_ME_OPENROUTER_API_KEY
# 以下配置可选，不填则使用 Provider 的预设值
# OpenRouter 默认使用 Gemma 4 26B 免费模型，并依次尝试 Xing4.0、Cohere North Mini Code 免费模型。
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=google/gemma-4-26b-a4b-it:free
# AI_FALLBACK_MODELS=xingchen-agi/xing4.0-29b-a4b:free,cohere/north-mini-code:free
